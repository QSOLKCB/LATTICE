{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/lattice-migration.schema.json",
  "title": "QSOL LATTICE Migration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "migration_id",
    "source_profile",
    "target_profile",
    "mode",
    "preserve_source_identity",
    "mappings",
    "metadata"
  ],
  "$defs": {
    "profileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "profile_id", "profile_fingerprint"],
      "properties": {
        "protocol": {"const": "qsol-lattice-profile-descriptor/1"},
        "profile_id": {"type": "string", "pattern": "^.+/[1-9][0-9]*$"},
        "profile_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "metadata": {"type": "object"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_address", "target_address"],
      "properties": {
        "source_address": {
          "type": "string",
          "pattern": "^L\\[[0-2],[0-2],[0-2]\\](?:/L\\[[0-2],[0-2],[0-2]\\]){0,7}$",
          "maxLength": 71
        },
        "target_address": {
          "type": "string",
          "pattern": "^L\\[[0-2],[0-2],[0-2]\\](?:/L\\[[0-2],[0-2],[0-2]\\]){0,7}$",
          "maxLength": 71
        }
      }
    }
  },
  "properties": {
    "protocol": {"const": "qsol-lattice-migration/1"},
    "migration_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_profile": {"$ref": "#/$defs/profileDescriptor"},
    "target_profile": {"$ref": "#/$defs/profileDescriptor"},
    "mode": {"enum": ["identity", "explicit-map"]},
    "preserve_source_identity": {"const": true},
    "mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/mapping"},
      "maxItems": 10000
    },
    "metadata": {"type": "object"}
  }
}
